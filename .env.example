# PostgreSQL connection string (Neon / Vercel Postgres on Vercel; local Postgres for dev)
DATABASE_URL=postgres://pawpass:pawpass@localhost:5432/pawpass

# Secret used to sign login tokens (JWT). At least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Vercel Blob token. Set automatically on Vercel when a Blob store is connected.
# Leave empty locally to store files in ./uploads instead.
BLOB_READ_WRITE_TOKEN=

# Optional
# PORT=3000
# UPLOAD_DIR=./uploads
# PG_POOL_MAX=3
